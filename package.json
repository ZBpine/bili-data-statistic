{
  "name": "bili-data-statistic",
  "private": true,
  "version": "3.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:local-bdm": "set BDS_DEV_LOCAL_BDM=1&& vite",
    "build": "node scripts/build-all.mjs",
    "preview": "vite preview",
    "dev:static": "npm run build:static && npm run preview:static",
    "dev:static:local-bdm": "set BDS_DEV_LOCAL_BDM=1&& npm run build:static && npm run preview:static",
    "build:static": "vite build --config vite.static.config.js && node scripts/build-static-html.mjs",
    "preview:static": "vite preview --config vite.static.config.js",
    "build:user:jsdelivr": "vite build",
    "build:user:jsdmirror": "set BDS_CDN_PROFILE=jsdmirror&& vite build"
  },
  "dependencies": {
    "@css-render/plugin-bem": "^0.15.14",
    "@css-render/vue3-ssr": "^0.15.14",
    "@vicons/tabler": "^0.13.0",
    "css-render": "^0.15.14",
    "naive-ui": "^2.44.1",
    "nb-ui": "github:ZBpine/bili-data-viewer#v0.1.0",
    "seemly": "^0.3.10",
    "vue": "^3.5.19"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^32.0.0",
    "vite": "^7.1.3",
    "vite-plugin-monkey": "^7.1.1"
  }
}
